*.yml linguist-detectable=true
*.yml linguist-language=YAML
*.yaml linguist-detectable=true
*.yaml linguist-language=YAML
*.sh text eol=lf

# Keep large generated model/data artifacts in LFS without capturing ordinary
# JSON manifests or configuration files.
artifacts/**/*.onnx filter=lfs diff=lfs merge=lfs -text
artifacts/**/*.engine filter=lfs diff=lfs merge=lfs -text
artifacts/**/*.ckpt filter=lfs diff=lfs merge=lfs -text
artifacts/**/*.pt filter=lfs diff=lfs merge=lfs -text
artifacts/**/*.pth filter=lfs diff=lfs merge=lfs -text
data/**/*.h5 filter=lfs diff=lfs merge=lfs -text
